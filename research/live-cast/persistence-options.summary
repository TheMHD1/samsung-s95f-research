SDB_UNIT
# /usr/lib/systemd/system/sdbd.service
[Unit]
Description=sdbd
After=tmp.mount

[Service]
User=sdk
Group=sdk
SmackProcessLabel=System
EnvironmentFile=-/run/sdbd-env
#If necessary, Put Environment variable settings in a file like below
#ExecStartPre=/bin/bash -c "/bin/echo 'SDB_TRACE=all SDBD_LOG_PATH=/tmp' >> /tmp/.sdbdlog.conf"
Type=notify
Capabilities=cap_kill,cap_dac_override,cap_setgid,cap_setuid,cap_sys_admin=i
SecureBits=keep-caps
PIDFile=/tmp/.sdbd.pid
RemainAfterExit=yes
ExecStart=/usr/sbin/sdbd $SDBD_CMDLINE
USBFunctionDescriptors=/etc/sdbd/descs
USBFunctionStrings=/etc/sdbd/strs

# /usr/lib/systemd/system/sdbd.service.d/exec.conf
[Service]
ExecStart=
ExecStart=/usr/bin/boostShell -a -r 5 -t 5000 -p /usr/sbin/sdbd $SDBD_CMDLINE

# /usr/lib/systemd/system/sdbd.service.d/restart-on-fail.conf
[Service]
RemainAfterExit=no
Restart=on-failure

# /usr/lib/systemd/system/sdbd_tcp.socket
[Unit]
Description=sdbd: TCP socket
ConditionPathExists=!/home/researcher/apps_rw/com.samsung.tv.store/data/develop_mode

[Socket]
ListenStream=26101
SmackLabelIPIn=*
SmackLabelIPOut=@
Service=sdbd.service

[Install]
WantedBy=sockets.target

# /usr/lib/systemd/system/sdbd_tcp.socket.d/store-develop-mode-release.conf
[Unit]
ConditionPathExists=
ConditionPathExists=/home/researcher/apps_rw/com.samsung.tv.store/data/develop_mode
