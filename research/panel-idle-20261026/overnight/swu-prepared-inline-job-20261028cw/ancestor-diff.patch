+def preparation_commands(spec: JobSpec) -> tuple[str, ...]:
+    """Prepare exact private script bytes through safe-alphabet transport only."""
+    child, worker = scripts(spec)
+    j = spec.job
+    commands = [exact_payloads(spec) + 'command -v setsid > /dev/null\n' +
+                f'test ! -e {j}\ntest ! -L {j}\nmkdir {j}\nchmod 700 {j}\n']
+    for name, text in (("plan", spec.digest + "\n"), ("child.sh", child), ("worker.sh", worker)):
+        raw = text.encode()
+        encoded = base64.b64encode(raw).decode('ascii')
+        prefix = directory_guard(spec) if name == 'plan' else job_guard(spec)
+        commands.append(prefix +
+                        f'test ! -e {j}/{name}\ntest ! -L {j}/{name}\n' +
+                        f"printf %s '{encoded}' | base64 -d > {j}/{name}\n" +
+                        f'chmod 600 {j}/{name}\n' +
+                        f'test "$(wc -c < {j}/{name})" = {len(raw)}\n' +
+                        f'test "$(sha256sum {j}/{name} | cut -d " " -f1)" = {hashlib.sha256(raw).hexdigest()}\n')
+    for command in commands:
+        need(len(command.encode()) <= 8192, 'preparation-command-too-large')
+    return tuple(commands)
+
